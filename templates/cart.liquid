<main class="wrap"><h1>Your cart</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<p>{{ item.product.title | escape }} — {{ item.final_line_price | money }} <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity"></p>{% endfor %}<p>{{ cart.total_price | money }}</p><button name="update" type="submit">Update cart</button><button name="checkout" type="submit">Checkout</button></form>{% else %}<p>Your cart is empty.</p>{% endif %}</main>